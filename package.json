{
  "name": "code-scrobble",
  "version": "1.0.0",
  "description": "CodeScrobble is a web application that makes it easy to scrobble your CD or vinyl records to Last.fm by scanning the barcode with your smartphone camera.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpuscher/code-scrobble.git"
  },
  "author": "Daniel Puscher",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dpuscher/code-scrobble/issues"
  },
  "homepage": "https://www.codescrobble.com/",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "analyze": "BUNDLE_ANALYZE=true yarn build",
    "migrate:full": "tsx scripts/migration/migrate-full.ts",
    "migrate:dry-run": "tsx scripts/migration/dry-run.ts",
    "migrate:parity": "tsx scripts/migration/parity-check.ts"
  },
  "dependencies": {
    "@ley0x/better-auth-lastfm": "^1.2.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@tanstack/react-query": "^5.90.21",
    "better-auth": "^1.4.18",
    "disconnect": "^1.2.2",
    "dotenv": "^17.3.1",
    "lastfmapi": "^0.1.1",
    "lodash": "^4.17.23",
    "mongoose": "^9.2.1",
    "next": "^16.1.6",
    "nprogress": "^0.2.0",
    "pg": "^8.18.0",
    "quagga": "^0.12.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-timeago": "^8.3.0",
    "redis": "^5.11.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@lavamoat/allow-scripts": "^3.4.3",
    "@lavamoat/preinstall-always-fail": "^2.1.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.3.0",
    "@types/nprogress": "^0.2.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "redis-mock": "^0.56.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0",
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "eslint-config-next>eslint-import-resolver-typescript>unrs-resolver": false,
      "prisma": true,
      "@prisma/engines": true,
      "esbuild": true,
      "prisma>@prisma/engines": true,
      "tsx>esbuild": false,
      "vite>esbuild": false,
      "vitest>vite-node>vite>esbuild": false,
      "vitest>vite>esbuild": false,
      "next>sharp": false
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml,css,scss}": [
      "prettier --write"
    ]
  }
}
