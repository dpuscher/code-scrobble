{
  "name": "code-scrobble",
  "version": "2.0.0",
  "private": true,
  "description": "CodeScrobble is a web application that makes it easy to scrobble your CD or vinyl records to Last.fm by scanning the barcode with your smartphone camera.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpuscher/code-scrobble.git"
  },
  "author": "Daniel Puscher",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dpuscher/code-scrobble/issues"
  },
  "homepage": "https://www.codescrobble.com/",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.capture.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "mongodb": "^7.0.0",
    "next": "^16.4.1",
    "nprogress": "^0.2.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-timeago": "^8.3.0",
    "swr": "^2.3.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "@eslint/js": "^10.0.0",
    "@next/bundle-analyzer": "^16.4.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.12.0"
}
